[Unit]
Description=Snarling Display Service
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
User=openpi
WorkingDirectory=/home/openpi/.openclaw/workspace/snarling
ExecStart=/home/openpi/displayhat-env/bin/python /home/openpi/.openclaw/workspace/snarling/snarling.py
Restart=on-failure
RestartSec=5
Nice=10
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/home/openpi/.openclaw/workspace/snarling"
# Gateway auth — create this file with your own OPENCLAW_GATEWAY_TOKEN
# (see README "Configure the gateway token"). Do NOT put the token in this file.
EnvironmentFile=/etc/snarling.env

[Install]
WantedBy=default.target
